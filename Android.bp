// Intel Houdini native-bridge prebuilts (ARM64 aarch64 -> x86_64).
// Replaces the berberis/libndk_translation bridge in ndk/Android.bp.
//
// cc_prebuilt_* rather than PRODUCT_COPY_FILES: the build refuses ELF
// binaries copied that way (same rule as ndk/ and mesa/ prebuilts).
//
// Only what source cannot provide is prebuilt (4 modules): the translator
// (libhoudini), its init companion (libtcb -- dlopen'ed by libhoudini at
// init; missing it aborts every ARM process with Fatal 0x0190017f), the
// binfmt runner (houdini64), and guest libc (the one guest lib with a source
// install rule, hence stem+relative path). The other 411 guest libs in
// /system/lib64/arm64 do NOT auto-build in this tree (verified 2026-10-14:
// zero .native_bridge variants in out/), so they are staged as prebuilts in
// the GENERATED BLOCK below (minus libc.so, which WOULD collide). The etc/
// set (cpuinfo, binfmt_misc entries, init rc) is non-ELF and installed via
// PRODUCT_COPY_FILES in device.mk, not here.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "houdini_prebuilt_defaults",
    compile_multilib: "64",
    strip: {
        none: true,
    },
    // NEEDEDs resolve at runtime against the host system libs, which Soong
    // cannot account for -- same reason as ndk_prebuilt_defaults /
    // mesa_prebuilt_defaults. libhoudini.so also exports the NativeBridgeItf
    // vtable that ART dlopen()s; not a standard Soong-visible ABI.
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libhoudini",
    defaults: ["houdini_prebuilt_defaults"],
    // Installs to /system/lib64/libhoudini.so -- the exact path AndroidRuntime
    // (frameworks/base/core/jni/AndroidRuntime.cpp) passes to ART via
    // -XX:NativeBridge=ro.dalvik.vm.native.bridge, and ART dlopen()s from the
    // system namespace (art/libnativebridge/native_bridge.cc OpenSystemLibrary).
    srcs: ["lib64/libhoudini.so"],
}

cc_prebuilt_library_shared {
    name: "libtcb",
    defaults: ["houdini_prebuilt_defaults"],
    // -> /system/lib64/libtcb.so. Companion libhoudini dlopen()s at init as
    // <dir>/libtcb.so (dir = its own); a missing file aborts every ARM
    // process AND bare `houdini64 -v` with Fatal error (ID:0x0190017f).
    srcs: ["lib64/libtcb.so"],
}

cc_prebuilt_library_shared {
    name: "houdini_guest_libc",
    defaults: ["houdini_prebuilt_defaults"],
    // Guest (ARM64) libc -> /system/lib64/arm64/libc.so. Same role as
    // ndk/Android.bp's ndk_guest_libc; renamed to avoid a duplicate-module
    // clash if both bridges are ever enabled together.
    srcs: ["lib64/arm64/libc.so"],
    stem: "libc",
    relative_install_path: "arm64",
}

cc_prebuilt_binary {
    name: "houdini64",
    defaults: ["houdini_prebuilt_defaults"],
    // -> /system/bin/houdini64. The binfmt_misc handler referenced by
    // etc/houdini/binfmt_misc/arm64_{exe,dyn} for arm64 (e_machine 0xb7).
    srcs: ["bin/houdini64"],
}
// GENERATED BLOCK (guest-libs): do not hand-edit.
// 411 ARM64 guest-lib prebuilts = full tested donor set
// (/run/media/lenovo/Dev/libhoudini/lib64/arm64). EXCLUDED: libc.so
// (ships via the houdini_guest_libc stem module).

cc_prebuilt_library_shared {
    name: "houdini_guest_aaudio-aidl-cpp",
    defaults: ["houdini_prebuilt_defaults"],
    srcs: ["lib64/arm64/aaudio-aidl-cpp.so"],
    stem: "aaudio-aidl-cpp",
    relative_install_path: "arm64",
}

