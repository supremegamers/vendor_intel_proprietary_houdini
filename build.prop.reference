# Houdini bridge props, trimmed from the donor's full system build.prop
# (/run/media/lenovo/Dev/libhoudini/build.prop, 188 lines, mostly donor
# fingerprint: build IDs, dexopt, bluetooth, zram — useless here).
#
# REFERENCE ONLY — nothing reads this file. The live values are
# PRODUCT_SYSTEM_PROPERTIES in device.mk (~1274). Per the libhoudini
# README §3d, these four are the complete bridge selection:
ro.dalvik.vm.native.bridge=libhoudini.so
ro.dalvik.vm.isa.arm64=x86_64
ro.dalvik.vm.isa.arm=x86
ro.enable.native.bridge.exec=1

# Deliberately NOT carried over from the donor dump:
# - ro.berberis.* (donor ran berberis as 2nd bridge; README says remove)
# - ro.*.cpu.abilist* (generated from TARGET_NATIVE_BRIDGE_ABI; README says
#   do not set by hand)
